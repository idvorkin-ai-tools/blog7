{#- Port of search-titles.json: title + url for posts, _d, _td, with the same
    exclusions as partials/pagefind_attrs.html. -#}
{%- set root = get_section(path="_index.md") -%}
{%- set all = root.pages | sort(attribute="extra.sort_key") -%}
{#- Tera 2 scopes `set` inside a for loop to that loop, so no accumulating. -#}
{%- set posts = [d for d in all if d.extra.collection == "posts"] | reverse -%}
{%- set ds = [d for d in all if d.extra.collection == "d"] -%}
{%- set tds = [d for d in all if d.extra.collection == "td"] -%}
{%- set entries = [...posts, ...ds, ...tds] -%}
{%- set keep = [p for p in entries if p.title and not p.extra.fj and not p.extra.search_exclude and "family-journal" not in (p.extra.tags_list or []) and p.extra.permalink not in config.extra.search_exclude_permalinks] -%}
[{% for p in keep %}{"t":{{ p.title | json_encode | safe }},"u":{{ p.extra.permalink | json_encode | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]
