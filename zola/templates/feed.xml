{#- Port of feed.xml (RSS 2.0, not Zola's Atom): every post (newest first),
    then _d and _td documents in collection order, full content. Undated
    documents get no pubDate (Jekyll stamped them with the build time). -#}
{%- set root = get_section(path="_index.md") -%}
{%- set all = root.pages | sort(attribute="extra.sort_key") -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title></title>
		<description>{{ config.description | escape_xml }}</description>
		<link>{{ config.base_url }}</link>
		<atom:link href="{{ config.base_url }}/feed.xml" rel="self" type="application/rss+xml" />
{%- for coll in ["posts", "d", "td"] %}
{%- set items = [d for d in all if d.extra.collection == coll] %}
{%- if coll == "posts" %}{% set items = items | reverse %}{% endif %}
{%- for post in items %}
			<item>
				<title>{{ post.title | escape_xml }}</title>
				<description>{{ post.content | escape_xml }}</description>
				{% if post.date %}<pubDate>{{ post.date | date(format="%a, %d %b %Y %H:%M:%S %z") }}</pubDate>{% endif %}
				<link>{{ config.base_url }}{{ post.extra.permalink }}</link>
				<guid isPermaLink="true">{{ config.base_url }}{{ post.extra.permalink }}</guid>
			</item>
{%- endfor %}
{%- endfor %}
	</channel>
</rss>
